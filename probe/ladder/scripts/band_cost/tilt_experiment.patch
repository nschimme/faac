diff --git a/libfaac/quantize.c b/libfaac/quantize.c
index 969331a..31eb58d 100644
--- a/libfaac/quantize.c
+++ b/libfaac/quantize.c
@@ -119,6 +119,21 @@ static float gain_with_overflow_clamp(int *sfac, float band_peak)
 #define PEAK_ENERGY_FLOOR_FRAC 0.0050f  // ~-23 dB floor, same purpose for peak energy
 #define QUIET_BAND_FRAC        0.0003f  // ~-35 dB below the frame mean: masked by the frame as a whole
 
+static float tilt_gain(int lo, int hi, int block_len)
+{
+    static float db = -1.0f, f0, f1, f2, f3;
+    if (db < 0.0f)
+    {
+        const char *e = getenv("TILT_DB"); db = e ? (float)atof(e) : 0.0f;
+        e = getenv("TILT_F"); sscanf(e ? e : "2500,3400,7000,10000", "%f,%f,%f,%f", &f0, &f1, &f2, &f3);
+    }
+    if (db == 0.0f) return 1.0f;
+    float f = 0.5f * (float)(lo + hi) / (float)block_len * 24000.0f, w;
+    if (f < f0 || f >= f3) return 1.0f;
+    if (f < f1) w = (f - f0) / (f1 - f0); else if (f <= f2) w = 1.0f; else w = (f3 - f) / (f3 - f2);
+    return powf(10.0f, db * w / 20.0f);
+}
+
 typedef struct
 {
     float sum;      /* energy summed across group windows */
@@ -253,6 +268,7 @@ static void derive_masking_targets(CoderInfo * __restrict ci, int gnum, float qu
         target = AVG_ENERGY_WEIGHT * loudness(avg / ref)
                + (1.0f - AVG_ENERGY_WEIGHT) * PEAK_ENERGY_WEIGHT * loudness(peak / ref_win);
         target *= treble_rolloff(lo, hi, slope_per_line);
+        target *= tilt_gain(lo, hi, block_len);
         /* A band this far under the frame is masked by it; the floors above
          * would otherwise pin its target at the floor. Falls at half the
          * loudness exponent. */
