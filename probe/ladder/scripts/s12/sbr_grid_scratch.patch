+/* The strongest onset of the frame as a slot in *onset (num_slots if none) with
+ * its ratio in *best, from the high-band energy per slot (hb). A slot is
+ * flagged when its energy exceeds gridT times the mean of the 8 slots before it
+ * (history carried across frames); an onset is the first flagged slot of a run,
+ * so a plateau after an attack is not a new onset, and the one with the largest
+ * ratio wins (a frame gets one border). Slots before `first` still update the
+ * state. */
+static void find_onset(SBRChannel *c, const SBRInfo *sbr, int num_slots, int first, int *onset, float *best)
+{
+    float sum = 0.0f;
+
+    for (int i = 0; i < 8; i++) sum += c->hbHist[i];
+    for (int slot = 0; slot < num_slots; slot++) {
+        float e = c->hb[slot];
+        float *old = &c->hbHist[slot & 7];
+        int flag = e > sbr->gridT * sum * 0.125f && e > SBR_ENERGY_FLOOR;
+        if (flag && !c->hbFlag && slot >= first) {
+            float ratio = e / (sum * 0.125f + SBR_ENERGY_FLOOR);
+            if (ratio > *best) { *best = ratio; *onset = slot; }
+        }
+        c->hbFlag = flag;
+        sum += e - *old;
+        *old = e;
+    }
+}
