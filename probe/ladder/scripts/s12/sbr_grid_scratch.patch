+/* The grid for an onset at time slot b (-1: none) given the leading border the
+ * previous frame's trailing one forces. Border positions reachable per class:
+ * VARFIX lead + 2..8 (even steps), FIXVAR/VARVAR trail - 2..8. The reachable
+ * border nearest b wins; ties go to the earlier border, then the class that
+ * carries no trailing border. */
+static void onset_grid(SignalAnalysis *sa, SBRInfo *sbr, int b)
+{
+    int lead = sbr->prevTrail;
+    int ne = sbr->numEnvFixFix;
+
+    if (b < 0 && !lead) {
+        sa->numEnvelopes = ne;
+        sa->frameClass = SBR_FRAME_CLASS_FIXFIX;
+        for (int e = 0; e <= ne; e++) sa->tEnv[e] = e * SBR_NUM_TIME_SLOTS / ne;
+        return;
     }
+    if (b < 0) {
+        /* The previous frame ran past its end: this one has to open at the
+         * border it left, so a plain grid is VARFIX from there, in even steps. */
+        int step = 2 * ((SBR_NUM_TIME_SLOTS - lead + ne) / (2 * ne));
+        sa->numEnvelopes = ne;
+        sa->frameClass = SBR_FRAME_CLASS_VARFIX;
+        sa->numRel0 = ne - 1;
+        for (int e = 0; e < ne; e++) sa->tEnv[e] = lead + e * step;
+        sa->tEnv[ne] = SBR_NUM_TIME_SLOTS;
+    } else {
+        int best = 99, pos = 0, trail = 0, fwd = 0;
+        /* d = -1: forward from the lead; d >= 0: backward from 16 + d. The
+         * step is the even one that lands nearest b, the earlier on a tie. */
+        for (int d = -1; d <= SBR_GRID_TRAIL; d++) {
+            int r = d < 0 ? (b - lead) & ~1 : (SBR_NUM_TIME_SLOTS + d - b + 1) & ~1;
+            r = r < 2 ? 2 : r > 8 ? 8 : r;
+            int p = d < 0 ? lead + r : SBR_NUM_TIME_SLOTS + d - r;
+            int dist = p > b ? p - b : b - p;
+            if (dist < best || (dist == best && p < pos)) {
+                best = dist;
+                pos = p;
+                fwd = d < 0;
+                trail = fwd ? 0 : d;
+            }
+        }
+        sa->numEnvelopes = 2;
+        sa->numRel0 = fwd;
+        sa->frameClass = fwd ? SBR_FRAME_CLASS_VARFIX : lead ? SBR_FRAME_CLASS_VARVAR : SBR_FRAME_CLASS_FIXVAR;
+        sa->tEnv[0] = lead;
+        sa->tEnv[1] = pos;
+        sa->tEnv[2] = SBR_NUM_TIME_SLOTS + trail;
+    }
+    sbr->prevTrail = sa->tEnv[sa->numEnvelopes] - SBR_NUM_TIME_SLOTS;
