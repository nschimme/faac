+
+/* One independent filter per short window (the syntax is per window, not per
+ * group). BlocGroup only decides group lengths; freqBuff still holds the 8
+ * windows as contiguous 128-line blocks here. */
+void TnsEncodeShort(CoderInfo *coderInfo, float *spec)
+{
+    TnsInfo *tnsInfo = &coderInfo->tnsInfo;
+    int b_start = min(tnsInfo->tnsMinBandNumberShort, coderInfo->sfbn);
+    int b_stop = min(tnsInfo->tnsMaxBandsShort, coderInfo->sfbn);
+    int w, atk = -1;
+
+    tnsInfo->tnsDataPresent = 0;
+    for (w = 0; w < MAX_SHORT_WINDOWS; w++)
+        tnsInfo->shortWin[w].numFilters = 0;
+    if (b_stop <= b_start)
+        return;
+
+    /* Attack window = largest E[w]/E[w-1] > 1 over w=1..7. w=0 is never chosen:
+     * the previous frame's last window isn't kept, and a frame whose rise is
+     * in window 0 is mostly a long-to-short transition artifact. */
+    if (tnsInfo->shortAtkOnly) {
+        float e[MAX_SHORT_WINDOWS], best = 1.0f;
+        int i;
+
+        for (w = 0; w < MAX_SHORT_WINDOWS; w++) {
+            const float *x = spec + w * BLOCK_LEN_SHORT;
+            float acc = 0.0f;
+            for (i = 0; i < BLOCK_LEN_SHORT; i++)
+                acc += x[i] * x[i];
+            e[w] = acc;
+        }
+        atk = -1;
+        for (w = 1; w < MAX_SHORT_WINDOWS; w++) {
+            float r = e[w] / (e[w - 1] > 1e-9f ? e[w - 1] : 1e-9f);
+            if (r > best) {
+                best = r;
+                atk = w;
+            }
+        }
+        if (atk < 0)
+            return;
+    }
+
+    for (w = 0; w < MAX_SHORT_WINDOWS; w++) {
+        TnsWindowData *win = &tnsInfo->shortWin[w];
+
+        if (atk >= 0 && w != atk)
+            continue;
+        if (!tns_fit_range(b_start, b_stop, coderInfo->sfb_offset,
+                           spec + w * BLOCK_LEN_SHORT, &win->tnsFilter[0],
+                           tnsInfo->shortOrder, tnsInfo->shortGain, tnsInfo->shortGain))
+            continue;
+        win->tnsFilter[0].length = tnsInfo->tnsNumSwbShort - b_start;
+        win->numFilters = 1;
+        win->coefResolution = DEF_TNS_COEFF_RES;
+        tnsInfo->tnsDataPresent = 1;
+    }
+}
