+/* RESEARCH (scratch): short-window TNS, all behind FAAC_STNS. Read once here
+ * (TnsInit runs once per open) so the per-frame path never touches the env.
+ * Master's long start band is a fixed sfb index per rate, not a frequency, so
+ * the short start is the first sfb at or above FAAC_STNS_HZ (default 1500). */
+static const uint8_t stns_max_bands[12] = { 9, 9, 10, 14, 14, 14, 14, 14, 14, 14, 14, 14 };
+
+static float stns_env_f(const char *name, float def)
+{
+    const char *v = getenv(name);
+    return (v && *v) ? (float)atof(v) : def;
+}
+
+static void stns_init(faacEncStruct *hEncoder, TnsInfo *info)
+{
+    const char *on = getenv("FAAC_STNS");
+    const char *prof = getenv("FAAC_STNS_PROFILE");
+    int he = IsSBR(hEncoder->config.aacObjectType);
+    int order, b, line = 0;
+    float hz, hz_per_line;
+
+    info->shortEnabled = 0;
+    info->shortAtkOnly = 0;
+    if (!on || on[0] != '1')
+        return;
+    if (prof && !strcmp(prof, "lc") && he)
+        return;
+    if (prof && !strcmp(prof, "he") && !he)
+        return;
+
+    order = (int)stns_env_f("FAAC_STNS_ORDER", 4.0f);
+    info->shortOrder = order < 1 ? 1 : (order > 7 ? 7 : order);
+    info->shortGain = stns_env_f("FAAC_STNS_GAIN", 1.4f);
+    hz = stns_env_f("FAAC_STNS_HZ", 1500.0f);
+
+    /* Core rate: sampleRate is already halved for the HE core. */
+    hz_per_line = (float)hEncoder->sampleRate / 2.0f / (float)BLOCK_LEN_SHORT;
+    /* sfbOffsetShort isn't built yet at TnsInit time, so walk the widths. */
+    for (b = 0; b < hEncoder->srInfo->num_cb_short; b++) {
+        if ((float)line * hz_per_line >= hz)
+            break;
+        line += hEncoder->srInfo->cb_width_short[b];
+    }
+    info->tnsMinBandNumberShort = b;
+    info->tnsMaxBandsShort = stns_max_bands[hEncoder->sampleRateIdx];
+    info->tnsNumSwbShort = hEncoder->srInfo->num_cb_short;
+    {
+        const char *atk = getenv("FAAC_STNS_ATK");
+        info->shortAtkOnly = atk && atk[0] == '1';
+    }
+    info->shortEnabled = 1;
+}
+
