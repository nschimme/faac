diff --git a/libfaad/decoder.c b/libfaad/decoder.c
index 162a779..f37fa44 100644
--- a/libfaad/decoder.c
+++ b/libfaad/decoder.c
@@ -1031,6 +1031,65 @@ static void core_dump_ics(int ch, const ICSInfo *ics, const float *spec,
 }
 #endif
 
+
+/* FAAD_DECDUMP: one text record per decision; F/I/B per element, S/P in sbr.c */
+FILE *faad_decdump;
+int faad_decdump_frame = -1;
+static bool decdump_tried;
+
+static void decdump_frame_begin(void)
+{
+    if (!decdump_tried) {
+        decdump_tried = true;
+        const char *path = getenv("FAAD_DECDUMP");
+        if (path && *path) faad_decdump = fopen(path, "w");
+    }
+    faad_decdump_frame++;
+}
+
+static void decdump_rate(const faad_decoder *d)
+{
+    if (faad_decdump && faad_decdump_frame == 0)
+        fprintf(faad_decdump, "R %u %u %u\n", d->core_sample_rate, FRAME_IS_960(d) ? 960 : 1024,
+                d->core_channels);
+}
+
+static void decdump_elem(const char *type, int ch, const CPEInfo *cpe, const ICSInfo *ics, bool pair)
+{
+    FILE *f = faad_decdump;
+    int fr = faad_decdump_frame;
+    int msm = pair ? (int)cpe->ms_mask_present : 0;
+    if (ch == -1) {
+        fprintf(f, "F %d %s %d %d\n", fr, type, pair ? (int)cpe->common_window : 0, msm);
+        return;
+    }
+    int nwin = ics->window_sequence == EIGHT_SHORT_SEQUENCE ? 8 : 1;
+    fprintf(f, "I %d %d %u %u %u %u ", fr, ch, ics->window_sequence, ics->window_shape,
+            ics->max_sfb, ics->num_window_groups);
+    for (int g = 0; g < ics->num_window_groups && g < 8; g++)
+        fprintf(f, "%s%u", g ? "," : "", ics->window_group_length[g]);
+    fprintf(f, " %u %d ", ics->global_gain, (int)ics->tns_data_present);
+    for (int w = 0; w < nwin; w++)
+        fprintf(f, "%s%u", w ? "," : "", ics->tns_data_present ? ics->tns_n_filt[w] : 0);
+    fputc(' ', f);
+    bool any = false;
+    for (int w = 0; w < nwin && ics->tns_data_present; w++)
+        for (int k = 0; k < ics->tns_n_filt[w] && k < 4; k++) {
+            fprintf(f, "%sw%d:o%u/l%u", any ? "+" : "", w, ics->tns_order[w][k], ics->tns_length[w][k]);
+            any = true;
+        }
+    if (!any) fputc('-', f);
+    fprintf(f, " %d %d\n", (int)ics->pulse_data_present, (int)ics->gain_control_present);
+    for (int g = 0; g < ics->num_window_groups && g < 8; g++)
+        for (int sfb = 0; sfb < ics->max_sfb && sfb < MAX_SFB; sfb++) {
+            int ms = 0;
+            if (pair && cpe->ms_mask_present == MS_MASK_ALL) ms = 1;
+            else if (pair && cpe->ms_mask_present == MS_MASK_EXPLICIT) ms = cpe->ms_used[g][sfb] != 0;
+            fprintf(f, "B %d %d %d %d %u %u %u %d %d\n", fr, ch, g, sfb, ics->sfb_offsets[sfb],
+                    ics->sfb_offsets[sfb + 1], ics->sfb_cb[g][sfb], ics->scalefactors[g][sfb], ms);
+        }
+}
+
 /* Clamp and round to nearest: truncating toward zero costs the output half
  * an LSB of error against any rounding decoder, on every sample. */
 static inline int16_t pcm_to_s16(float v)
@@ -1125,6 +1184,8 @@ FAADAPI faad_status faad_decode_frame(faad_decoder *decoder,
     }
     *bytes_consumed = adts_frame_len;
     decoder->num_channels = decoder->core_channels;
+    decdump_frame_begin();
+    decdump_rate(decoder);
 #ifndef FAAD_DISABLE_DRC
     decoder->drc.present = false;
 #endif
@@ -1202,6 +1263,10 @@ FAADAPI faad_status faad_decode_frame(faad_decoder *decoder,
                 core_dump_ics(elem_ch, ics, decoder->spec[elem_ch], NULL,
                               bits_get_consumed(&bs) - b0);
 #endif
+                if (faad_decdump) {
+                    decdump_elem(syntax_id == ID_LFE ? "LFE" : "SCE", -1, NULL, ics, false);
+                    decdump_elem(NULL, (int)elem_ch, NULL, ics, false);
+                }
                 decoder->win_seq[elem_ch] = ics->window_sequence;
                 decoder->win_shape[elem_ch] = ics->window_shape;
                 apply_pns(ics, decoder->spec[elem_ch], &decoder->pns_seed);
@@ -1248,6 +1313,11 @@ FAADAPI faad_status faad_decode_frame(faad_decoder *decoder,
                     core_dump_ics(elem_ch + 1, &cpe->ics[1], decoder->spec[elem_ch + 1], ms, cpe->ms_mask_present);
                 }
 #endif
+                if (faad_decdump) {
+                    decdump_elem("CPE", -1, cpe, &cpe->ics[0], true);
+                    decdump_elem(NULL, (int)elem_ch, cpe, &cpe->ics[0], true);
+                    decdump_elem(NULL, (int)elem_ch + 1, cpe, &cpe->ics[1], true);
+                }
                 for (uint32_t i = 0; i < 2; i++) {
                     decoder->win_seq[elem_ch + i] = cpe->ics[i].window_sequence;
                     decoder->win_shape[elem_ch + i] = cpe->ics[i].window_shape;
