+                    (int)el->amp_res, el->start_freq, el->stop_freq, el->xover_band, el->freq_scale,
+                    ch->L_E, ch->frame_class, ch->L_Q);
+            for (int k = 0; k < el->n_q && k < SBR_MAX_NQ; k++)
+                fprintf(faad_decdump, "%s%u", k ? "," : "", ch->invf_mode[k]);
+            fprintf(faad_decdump, " %d %d\n", (int)ch->add_harmonic_flag, (int)el->coupling);
+        }
+    }
     dec->sbr_present = true;
     return FAAD_OK;
 }
