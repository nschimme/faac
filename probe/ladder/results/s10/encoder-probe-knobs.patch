+/* PROBE: choose each PNS energy within +-tol steps of its target so the
+ * delta chain codes in the fewest bits (Viterbi over book12 lengths). */
+#include "huffdata.h"
+static void pns_smooth(CoderInfo *coder, int tol)
+{
+    int idx[MAX_SCFAC_BANDS], n = 0, i, o;
+    for (i = 0; i < coder->bandcnt; i++)
+        if (coder->book[i] == HCB_PNS) idx[n++] = i;
+    if (n < 2 || tol < 1) return;
+    enum { W = 9 };
+    int cost[W], ncost[W], back[MAX_SCFAC_BANDS][W];
+    int orig[MAX_SCFAC_BANDS];
+    for (i = 0; i < n; i++) orig[i] = coder->sf[idx[i]];
+    for (o = 0; o < W; o++) cost[o] = 0; /* band 0 is coded absolute and stays put */
+    for (i = 1; i < n; i++) {
+        for (o = -tol; o <= tol; o++) {
+            int best = 1 << 28, bp = 0;
+            for (int po = -tol; po <= tol; po++) {
+                int c0 = cost[po + tol];
+                if (i == 1 && po != 0) continue;
+                int d = (orig[i] + o) - (orig[i - 1] + po);
+                if (d < -60 || d > 60) continue;
+                int v = c0 + book12[SF_DELTA + d].len;
+                if (v < best) { best = v; bp = po; }
+            }
+            ncost[o + tol] = best; back[i][o + tol] = bp;
+        }
+        for (o = 0; o < 2 * tol + 1; o++) cost[o] = ncost[o];
+    }
+    int bo = 0, bc = 1 << 28;
+    for (o = -tol; o <= tol; o++) if (cost[o + tol] < bc) { bc = cost[o + tol]; bo = o; }
+    if (bc >= 1 << 28) return;
+    for (i = n - 1; i >= 1; i--) { coder->sf[idx[i]] = orig[i] + bo; bo = back[i][bo + tol]; }
+}
