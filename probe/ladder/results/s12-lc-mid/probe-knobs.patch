diff --git a/libfaac/quantize.c b/libfaac/quantize.c
index de61650..0c55cf4 100644
--- a/libfaac/quantize.c
+++ b/libfaac/quantize.c
@@ -147,7 +147,7 @@ typedef struct
 /* Masking-model parameters, not AAC syntax constants or an absolute hearing
  * threshold. The default balance and fitted stereo profile share these
  * controls; changing them redistributes quantization error between bands. */
-static const MaskingModel masking_model = {
+static MaskingModel masking_model = {
     /* Time-domain RMS in 16-bit PCM units; silence_energy() converts it to
      * this MDCT's energy scale so the gate is independent of block length. */
     .silence_rms = 0.4f,
@@ -305,9 +305,44 @@ static float tilt_gain(float khz)
     return gain;
 }
 
+#include <stdlib.h>
+#include <string.h>
+/* FAAC_MM="key=val,..." overrides masking_model: pw peak_weight, af avg_floor, pf peak_floor,
+ * qb quiet_band, sm sf_smooth, rs rich_slope, aw/le/ss profile[1] avg_weight/loud_exponent/
+ * slope_scale, t0..t7 tilt knot gain offset in dB. */
+static void mm_env(void)
+{
+    static int done;
+    const char *e = getenv("FAAC_MM");
+    char buf[512], *tok, *sv;
+    if (done) return;
+    done = 1;
+    if (!e) return;
+    strncpy(buf, e, sizeof buf - 1); buf[sizeof buf - 1] = 0;
+    for (tok = strtok_r(buf, ",", &sv); tok; tok = strtok_r(NULL, ",", &sv))
+    {
+        char *eq = strchr(tok, '=');
+        float v;
+        if (!eq) continue;
+        *eq = 0; v = (float)atof(eq + 1);
+        if (!strcmp(tok, "pw")) masking_model.peak_weight = v;
+        else if (!strcmp(tok, "af")) masking_model.avg_floor = v;
+        else if (!strcmp(tok, "pf")) masking_model.peak_floor = v;
+        else if (!strcmp(tok, "qb")) masking_model.quiet_band = v;
+        else if (!strcmp(tok, "sm")) masking_model.sf_smooth = v;
+        else if (!strcmp(tok, "rs")) masking_model.rich_slope = v;
+        else if (!strcmp(tok, "aw")) masking_model.profiles[1].avg_weight = v;
+        else if (!strcmp(tok, "le")) masking_model.profiles[1].loud_exponent = v;
+        else if (!strcmp(tok, "ss")) masking_model.profiles[1].slope_scale = v;
+        else if (tok[0] == 't' && tok[1] >= '0' && tok[1] <= '7')
+            masking_model.tilt[tok[1] - '0'].gain *= powf(10.0f, v / 20.0f);
+    }
+}
+
 void QuantizeConfigureMask(AACQuantCfg *cfg, unsigned sample_rate,
                            unsigned long bitrate_per_ch, unsigned channels, int is_he)
 {
+    mm_env();
     const int tuned = bitrate_per_ch >= masking_model.tune_min_rate
                    && channels == 2 && !is_he;
     const unsigned profile = tuned ? MASKING_PROFILE_TUNED : MASKING_PROFILE_DEFAULT;
