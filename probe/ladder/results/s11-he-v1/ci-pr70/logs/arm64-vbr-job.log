2026-10-15T00:17:20.1567095Z ##[start-action display=Fingerprint Dataset Generator;id=__nschimme_faac-benchmark_2.ds-key]
2026-10-15T00:17:20.1591800Z ##[group]Run # Hashed in Python, not `sha256sum | cut`, and with no fallback on
2026-10-15T00:17:20.1592309Z # Hashed in Python, not `sha256sum | cut`, and with no fallback on
2026-10-15T00:17:20.1592703Z # failure. Both matter, and for the same reason.
2026-10-15T00:17:20.1592985Z #
2026-10-15T00:17:20.1593276Z # A pipeline reports its LAST command's status, and cut exits 0 on empty
2026-10-15T00:17:20.1593773Z # input -- so `h=$(sha256sum ... | cut) || h=unhashed` can never take its
2026-10-15T00:17:20.1594243Z # fallback. A missing hasher would leave h empty and the key would read
2026-10-15T00:17:20.1594705Z # "Linux-datasets-": the constant this step exists to eliminate,
2026-10-15T00:17:20.1595170Z # reintroduced silently. Python also removes the portability question,
2026-10-15T00:17:20.1595682Z # since setup-python above guarantees it and sha256sum is coreutils-only.
2026-10-15T00:17:20.1596053Z #
2026-10-15T00:17:20.1596323Z # No `|| default` here at all: a key that cannot be computed must fail
2026-10-15T00:17:20.1596765Z # the run loudly. Degrading to any fixed string rebuilds the same
2026-10-15T00:17:20.1597208Z # never-expiring cache, and the failure would again be invisible.
2026-10-15T00:17:20.1597563Z h=$(python3 -c \
2026-10-15T00:17:20.1597969Z   'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest()[:16])' \
2026-10-15T00:17:20.1598558Z   "/home/runner/work/_actions/nschimme/faac-benchmark/master/setup_datasets.py")
2026-10-15T00:17:20.1598976Z echo "hash=$h" >> $GITHUB_OUTPUT
2026-10-15T00:17:20.1599245Z echo "Dataset generator hash: $h"
2026-10-15T00:17:20.1635684Z shell: /usr/bin/bash --noprofile --norc -e -o pipefail {0}
