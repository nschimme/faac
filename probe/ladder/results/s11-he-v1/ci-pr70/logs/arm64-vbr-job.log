2026-10-15T00:17:48.3729334Z ##[start-action display=Fingerprint Dataset Generator;id=__nschimme_faac-benchmark_3.ds-key]
2026-10-15T00:17:48.3753231Z ##[group]Run # Hashed in Python, not `sha256sum | cut`, and with no fallback on
2026-10-15T00:17:48.3753987Z # Hashed in Python, not `sha256sum | cut`, and with no fallback on
2026-10-15T00:17:48.3754404Z # failure. Both matter, and for the same reason.
2026-10-15T00:17:48.3754698Z #
2026-10-15T00:17:48.3754997Z # A pipeline reports its LAST command's status, and cut exits 0 on empty
2026-10-15T00:17:48.3755475Z # input -- so `h=$(sha256sum ... | cut) || h=unhashed` can never take its
2026-10-15T00:17:48.3755951Z # fallback. A missing hasher would leave h empty and the key would read
2026-10-15T00:17:48.3756416Z # "Linux-datasets-": the constant this step exists to eliminate,
2026-10-15T00:17:48.3756892Z # reintroduced silently. Python also removes the portability question,
2026-10-15T00:17:48.3757392Z # since setup-python above guarantees it and sha256sum is coreutils-only.
2026-10-15T00:17:48.3757778Z #
2026-10-15T00:17:48.3758052Z # No `|| default` here at all: a key that cannot be computed must fail
2026-10-15T00:17:48.3758507Z # the run loudly. Degrading to any fixed string rebuilds the same
2026-10-15T00:17:48.3758962Z # never-expiring cache, and the failure would again be invisible.
2026-10-15T00:17:48.3759322Z h=$(python3 -c \
2026-10-15T00:17:48.3759724Z   'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest()[:16])' \
2026-10-15T00:17:48.3760310Z   "/home/runner/work/_actions/nschimme/faac-benchmark/master/setup_datasets.py")
2026-10-15T00:17:48.3761029Z echo "hash=$h" >> $GITHUB_OUTPUT
2026-10-15T00:17:48.3761319Z echo "Dataset generator hash: $h"
2026-10-15T00:17:48.3796994Z shell: /usr/bin/bash --noprofile --norc -e -o pipefail {0}
