+static int sbr_envcount_env(const char *name, int fallback)
+{
+    const char *value = getenv(name);
+    if (!value || !*value) return fallback;
+    char *end = NULL;
+    errno = 0;
+    long parsed = strtol(value, &end, 10);
+    return errno || end == value || *end || parsed < 0 || parsed > 3 ? fallback : (int)parsed;
+}
+
+static float sbr_envcount_lambda(void)
+{
+    const char *value = getenv("FAAC_SBR_ENVCOUNT_LAMBDA");
+    if (!value || !*value) return 0.03f;
+    char *end = NULL;
+    errno = 0;
+    float parsed = strtof(value, &end);
+    return errno || end == value || *end || !isfinite(parsed) || parsed < 0.0f ? 0.03f : parsed;
+}
