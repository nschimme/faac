+static void sbr_make_candidate(const SBRInfo *sbr, int nch, const bool *isLfe,
+                              const SignalAnalysis *sa, int count, SbrFrameData *fd)
+{
+    memset(fd, 0, sbr_frame_candidate_size(nch));
+    fd->numEnvelopes = (uint8_t)count;
+    fd->frameClass = SBR_FRAME_CLASS_FIXFIX;
+    fd->freqRes = (uint8_t)sbr->bs_freq_res;
+    fd->eff_amp_res = count == 1 ? 0 : SBR_AMP_RES;
+    for (int e = 0; e <= count; e++)
+        fd->tEnv[e] = (uint8_t)(e * SBR_NUM_TIME_SLOTS / count);
+
+    int nb = sbr_env_bands(sbr, fd);
+    const int *edges = sbr_env_edges(sbr, fd);
+    float total = 0.0f;
+    for (int ch = 0; ch < nch; ch++) {
+        if (isLfe[ch]) continue;
+        for (int slot = 0; slot < (2 * FRAME_LEN) / SBR_QMF_BANDS_64; slot++)
+            for (int b = 0; b < nb; b++)
+                for (int k = edges[b]; k < edges[b + 1]; k++)
+                    total += sa->ch[ch].slotBandE[slot][k];
+    }
+
+    float distortion = 0.0f;
+    int dlav = fd->eff_amp_res ? SBR_ENV_DELTA_LIMIT_HIRES : SBR_ENV_DELTA_LIMIT_LORES;
+    for (int ch = 0; ch < nch; ch++) {
+        if (isLfe[ch]) continue;
+        int sampled[SBR_MAX_ENVELOPES] = {0};
+        float envEnergy[SBR_MAX_ENVELOPES][SBR_QMF_BANDS_64] = {{0}};
+        int slots = (2 * FRAME_LEN) / SBR_QMF_BANDS_64;
+        for (int slot = 0; slot < slots; slot++) {
+#if FAAC_SBR_DECIMATION > 1
+            if (slot % FAAC_SBR_DECIMATION != 0) continue;
+#endif
+            int e = slot * count / slots;
+            sampled[e]++;
+            for (int k = sbr->kx; k < sbr->k2; k++)
+                envEnergy[e][k] += sa->ch[ch].slotBandE[slot][k];
+        }
+        for (int e = 0; e < count; e++) {
+            int prev = -1;
+            int eSlots = sampled[e] > 0 ? sampled[e] : 1;
+            for (int b = 0; b < nb; b++) {
+                float energy = 0.0f;
+                for (int k = edges[b]; k < edges[b + 1]; k++) energy += envEnergy[e][k];
+                energy /= (float)(eSlots * (edges[b + 1] - edges[b]));
+                int level = lrintf((fd->eff_amp_res ? 1.0f : 2.0f) *
+                                   (fast_log2(energy + SBR_LOG_ENERGY_FLOOR) - SBR_ENV_LEVEL_LOG2_OFFSET));
+                int raw = clamp_int(level, 0, 127);
+                if (prev < 0) raw = clamp_int(raw, 0, fd->eff_amp_res ? 63 : 127);
+                else raw = clamp_int(raw, prev - dlav, prev + dlav);
+                fd->ch[ch].envData[e][b] = prev = raw;
+            }
+        }
+        for (int slot = 0; slot < slots; slot++) {
+            int e = slot * count / slots;
+            float weight = total > 0.0f ? 1.0f / total : 0.0f;
+            for (int b = 0; b < nb; b++) {
+                float reconstructed = exp2f((float)fd->ch[ch].envData[e][b] /
+                    (fd->eff_amp_res ? 1.0f : 2.0f) + SBR_ENV_LEVEL_LOG2_OFFSET);
+                float bandEnergy = 0.0f;
+                for (int k = edges[b]; k < edges[b + 1]; k++) {
+                    bandEnergy += sa->ch[ch].slotBandE[slot][k];
+                }
+                float original = bandEnergy / (float)(edges[b + 1] - edges[b]);
+                if (original > 0.0f && reconstructed > 0.0f) {
+                    float delta = log2f(original + SBR_LOG_ENERGY_FLOOR) -
+                                  log2f(reconstructed + SBR_LOG_ENERGY_FLOOR);
+                    distortion += weight * bandEnergy * delta * delta;
+                }
+            }
+        }
+    }
+    fd->distortion = isfinite(distortion) ? distortion : FLT_MAX;
+}
+
+void SbrEncodeCandidates(SBRInfo *sbr, float *timeDomain[MAX_CHANNELS], int numChannels,
+                         const bool *isLfe, int numSamples, SignalAnalysis *sa,
+                         SbrFrameSlot *slot, int mode, float lambda, int stack)
+{
+    for (int ch = 0; ch < numChannels; ch++)
+        if (!isLfe[ch])
+            memcpy(sbr->ch[ch].qmfOvl64, timeDomain[ch] + numSamples - SBR_QMF_HIST_LEN,
+                   SBR_QMF_HIST_LEN * sizeof(float));
+
+    SbrFrameData *first = sbr_frame_candidate(slot, 0, numChannels);
+    sbr_adopt_envelope_grid(sbr, sa, first);
+    sbr_quantize_envelopes(sbr, numChannels, isLfe, sa, first);
+    slot->candidateCount = 1;
+    slot->selectedReady = 0;
+    slot->envCountMode = (uint8_t)mode;
+    slot->envCountStack = (uint8_t)stack;
+    slot->envCountLambda = lambda;
+
+    if (sa->frameClass == SBR_FRAME_CLASS_FIXFIX && mode > 0 && !(mode == 3 && numChannels > 2)) {
+        int counts[3], n = 0;
+        if (mode == 1 && sbr->ratePerChannel < 36000) {
+            /* The fixed-tier control follows the upstream 1/2-envelope rule
+             * below its four-envelope threshold. */
+        } else if (mode == 1 || mode == 2) {
+            counts[n++] = 4;
+        } else {
+            counts[n++] = 1;
+            counts[n++] = 2;
+            counts[n++] = 4;
+        }
+        if (n) {
+            slot->candidateCount = 0;
+            for (int i = 0; i < n; i++) {
+                SbrFrameData *candidate = sbr_frame_candidate(slot, slot->candidateCount, numChannels);
+                sbr_make_candidate(sbr, numChannels, isLfe, sa, counts[i], candidate);
+                slot->candidateCount++;
+            }
+        }
+    }
+#ifdef FAAC_STATS
+    g_faacStats.sbrFrames++;
+    if (first->frameClass != SBR_FRAME_CLASS_FIXFIX) g_faacStats.sbrTransientFrames++;
+    for (int ch = 0; ch < numChannels; ch++) if (!isLfe[ch]) {
+        g_faacStats.sbrInvfSum += SBR_INVF_MODE;
+        g_faacStats.sbrInvfCount++;
+    }
+#endif
+}
