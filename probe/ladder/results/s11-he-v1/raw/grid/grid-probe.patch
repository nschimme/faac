+static void sbr_quantize_env(const SBRInfo *sbr, const SignalAnalysis *sa, const float *bandE,
+                             int env, int freqRes, int ampRes, int *levels)
+{
+    int nb = freqRes ? sbr->numBands : sbr->numBandsLow;
+    const int *edges = freqRes ? sbr->bandEdges : sbr->bandEdgesLow;
+    int dlav = ampRes ? SBR_ENV_DELTA_LIMIT_HIRES : SBR_ENV_DELTA_LIMIT_LORES;
+    int prevLevel = -1;
+    int eSlots = sa->envSampled[env] > 0 ? sa->envSampled[env] : 1;
+    for (int b = 0; b < nb; b++) {
+        int lo = edges[b], hi = edges[b + 1];
+        float energy = 0.0f;
+        for (int k = lo; k < hi; k++) energy += bandE[k];
+        energy /= (float)(eSlots * (hi - lo));
+        float factor = ampRes ? 1.0f : 2.0f;
+        int level = lrintf(factor * (fast_log2(energy + SBR_LOG_ENERGY_FLOOR) - SBR_ENV_LEVEL_LOG2_OFFSET));
+        int raw = clamp_int(level, 0, 127);
+        if (prevLevel < 0)
+            raw = clamp_int(raw, 0, ampRes ? 63 : 127);
+        else
+            raw = clamp_int(raw, prevLevel - dlav, prevLevel + dlav);
+        levels[b] = prevLevel = raw;
+    }
+}
