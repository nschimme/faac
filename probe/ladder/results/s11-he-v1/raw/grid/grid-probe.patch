+/* Frequency-only cost proxy: exact Huffman lengths for the coded frequency
+ * deltas, excluding time-delta opportunities and one resolution flag bit. */
+static int sbr_frequency_cost(const int *levels, int nb, int ampRes)
+{
+    static const int offset[2] = {0, 134};
+    static const int lav[2] = {60, 31};
+    static const int start[2] = {7, 6};
+    const uint16_t *table = sbr_env_codes + offset[ampRes] + lav[ampRes];
+    int bits = start[ampRes];
+    for (int b = 1; b < nb; b++) {
+        int delta = levels[b] - levels[b - 1];
+        if (delta < -lav[ampRes] || delta > lav[ampRes]) return INT_MAX;
+        bits += table[delta] & 31;
+    }
+    return bits;
+}
+
+static int sbr_flat_low_proxy(const SBRInfo *sbr, const SignalAnalysis *sa,
+                              const bool *isLfe, int nch, int env, int ratioLimit)
+{
+    if (!ratioLimit || sbr->numBandsLow >= sbr->numBands) return 0;
+    int slots = sa->envSampled[env] > 0 ? sa->envSampled[env] : 1;
+    for (int ch = 0; ch < nch; ch++) {
+        if (isLfe[ch]) continue;
+        for (int lb = 0; lb < sbr->numBandsLow; lb++) {
+            double minPower = HUGE_VAL, maxPower = 0.0;
+            int members = 0;
+            int lo = sbr->bandEdgesLow[lb], hi = sbr->bandEdgesLow[lb + 1];
+            for (int hb = 0; hb < sbr->numBands; hb++) {
+                int h0 = sbr->bandEdges[hb], h1 = sbr->bandEdges[hb + 1];
+                if (h0 < lo || h1 > hi) continue;
+                double power = 0;
+                for (int k = h0; k < h1; k++) power += sa->ch[ch].bandE[env][k];
+                power /= (double)(slots * (h1 - h0));
+                if (power < minPower) minPower = power;
+                if (power > maxPower) maxPower = power;
+                members++;
+            }
+            if (members < 2) continue;
+            if (minPower <= SBR_ENERGY_FLOOR || maxPower / minPower > ratioLimit / 10.0)
+                return 0;
+        }
+    }
+    return 1;
+}
+
+static int sbr_choose_low_proxy(const SBRInfo *sbr, const SignalAnalysis *sa,
+                                const bool *isLfe, int nch, int env, int ratioLimit,
+                                int ampRes)
+{
+    int high[SBR_MAX_BANDS], low[SBR_MAX_BANDS];
+    int highCost = 0, lowCost = 0;
+    if (!sbr_flat_low_proxy(sbr, sa, isLfe, nch, env, ratioLimit)) return 0;
+    for (int ch = 0; ch < nch; ch++) {
+        if (isLfe[ch]) continue;
+        sbr_quantize_env(sbr, sa, sa->ch[ch].bandE[env], env, 1, ampRes, high);
+        sbr_quantize_env(sbr, sa, sa->ch[ch].bandE[env], env, 0, ampRes, low);
+        int h = sbr_frequency_cost(high, sbr->numBands, ampRes);
+        int l = sbr_frequency_cost(low, sbr->numBandsLow, ampRes);
+        if (h == INT_MAX || l == INT_MAX) return 0;
+        highCost += h;
+        lowCost += l;
+    }
+    return lowCost < highCost;
 }
 
