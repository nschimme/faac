+static int sbr_border_probe_mode(void)
+{
+    const char *value = getenv("FAAC_SBR_BORDER_MODE");
+    if (!value || !*value) return 0;
+    char *end = NULL;
+    errno = 0;
+    long parsed = strtol(value, &end, 10);
+    return errno || end == value || *end || parsed != 1 ? 0 : 1;
+}
+
+static float sbr_border_probe_lambda(void)
+{
+    const char *value = getenv("FAAC_SBR_BORDER_LAMBDA");
+    if (!value || !*value) return 0.001f;
+    char *end = NULL;
+    errno = 0;
+    float parsed = strtof(value, &end);
+    return errno || end == value || *end || !isfinite(parsed) ||
+           (parsed != 0.001f && parsed != 0.003f) ? 0.001f : parsed;
+}
