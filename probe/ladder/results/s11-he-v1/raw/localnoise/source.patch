+static int sbr_probe_int(const char *name, int fallback, int min, int max)
+{
+    const char *text = getenv(name);
+    char *end;
+    long value;
+
+    if (!text || !*text) return fallback;
+    errno = 0;
+    value = strtol(text, &end, 10);
+    if (errno || end == text || *end || value < min || value > max) return fallback;
+    return (int)value;
+}
