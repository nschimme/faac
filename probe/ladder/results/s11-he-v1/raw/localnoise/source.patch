+static void sbr_build_source_map(SBRInfo *sbr)
+{
+    int k0 = sbr->kx, kx = sbr->kx, k2 = sbr->k2, M = k2 - kx;
+    int msb = k0, usb = kx, np = 0, patchStart[SBR_MAX_BANDS], patchNum[SBR_MAX_BANDS];
+    int goal_sb = (int)((2048000 + ((unsigned int)sbr->sampleRate >> 1)) / sbr->sampleRate);
+    int k;
+    memset(sbr->sourceMap, 255, sizeof(sbr->sourceMap));
+    if (goal_sb < kx + M) {
+        for (k = 0; k < sbr->numBands && sbr->bandEdges[k] < goal_sb; k++) ;
+    } else {
+        k = sbr->numBands;
+    }
+    int sb;
+    for (int pass = 0; pass < 4 * 6; pass++) {
+        int j = k + 1, odd;
+        do {
+            j--;
+            sb = sbr->bandEdges[j];
+            odd = (sb - 2 + k0) & 1;
+        } while (sb > k0 - 1 + msb - odd && j > 0);
+
+        int num = sb - usb > 0 ? sb - usb : 0;
+        int patch_start = k0 - odd - num;
+        if (num > 0) {
+            if (np < SBR_MAX_BANDS) { patchStart[np] = usb; patchNum[np] = num; }
+            for (int x = 0; x < num; x++) {
+                int target = usb + x, source = patch_start + x;
+                if (target >= 0 && target < SBR_QMF_BANDS_64 && source >= 0 && source < kx)
+                    sbr->sourceMap[target] = (uint8_t)source;
+            }
+            usb = sb;
+            msb = sb;
+            np++;
+        } else {
+            msb = kx;
+        }
+        if (k < sbr->numBands && sbr->bandEdges[k] - sb < 3) k = sbr->numBands;
+        if (sb == kx + M) break;
+        if (pass == 4 * 6 - 1) memset(sbr->sourceMap, 255, sizeof(sbr->sourceMap));
+    }
+    if (np > 1 && patchNum[np - 1] < 3) {
+        for (int x = 0; x < patchNum[np - 1]; x++) sbr->sourceMap[patchStart[np - 1] + x] = 255;
+        np--;
+    }
+    if (!np) memset(sbr->sourceMap, 255, sizeof(sbr->sourceMap));
+}
