+static int sbr_probe_harmonic_threshold(void)
+{
+    const char *text = getenv("FAAC_SBR_PROBE_HARMONIC");
+    char *end;
+    long value;
+
+    if (!text || !*text) return 0;
+    errno = 0;
+    value = strtol(text, &end, 10);
+    if (errno || end == text || *end || value < 50 || value > 95) return 0;
+    return (int)value;
+}
+
+static void sbr_probe_harmonics(const SBRInfo *sbr, int nch, const bool *isLfe,
+                                const struct SignalAnalysis *sa, SbrFrameData *fd)
+{
+    int threshold = sbr_probe_harmonic_threshold();
+
+    for (int ch = 0; ch < nch; ch++) {
+        memset(fd->ch[ch].harmonic, 0, sizeof(fd->ch[ch].harmonic));
+        if (!threshold || isLfe[ch]) continue;
+
+        const float (*bandE)[SBR_QMF_BANDS_64] = sa->ch[ch].bandE;
+        for (int b = 0; b < sbr->numBands; b++) {
+            int lo = sbr->bandEdges[b], hi = sbr->bandEdges[b + 1];
+            if (hi - lo < 3) continue;
+            int mid = (lo + hi) / 2;
+            bool concentrated = true;
+            for (int e = 0; e < fd->numEnvelopes; e++) {
+                float sum = 0.0f;
+                for (int k = lo; k < hi; k++) sum += bandE[e][k];
+                if (sum <= SBR_ENERGY_FLOOR || bandE[e][mid] / sum < (float)threshold / 100.0f) {
+                    concentrated = false;
+                    break;
+                }
+            }
+            fd->ch[ch].harmonic[b] = concentrated;
+        }
+    }
+}
