+    { const char *e = getenv("FAAC_SBR_STOP"); if (e) sbr->bs_stop_freq = atoi(e); }
     sbr->k2 = compute_k2(sampleRate, sbr->bs_stop_freq);
 
     build_freq_table(sbr);
